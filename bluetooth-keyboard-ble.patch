diff --git a/modules/bluetooth-hid/android/src/main/java/expo/modules/bluetoothhid/BleHidKeyboard.kt b/modules/bluetooth-hid/android/src/main/java/expo/modules/bluetoothhid/BleHidKeyboard.kt
